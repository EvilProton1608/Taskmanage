# Server configuration
PORT=
NODE_ENV=development

# Supabase PostgreSQL
# Get this from Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Session pooler" (port 5432) for long-running servers,
# or the "Direct connection" (port 5432, IPv6 required) for local dev.
DATABASE_URL=

# JWT — replace with a long random secret in production
JWT_SECRET=your_generated_jwt_token
JWT_EXPIRES_IN=7d
